# Runs bugun-backup.service every day at 21:30 UTC (02:30 Tashkent), with a
# catch-up run after downtime. See bugun-backup.service for installation.
[Unit]
Description=Daily Bugun backup

[Timer]
OnCalendar=*-*-* 21:30:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
