# Server .env template. Copy it next to the checkout (default
# <DEPLOY_DIR>/../.env, or point BUGUN_ENV_FILE at it), fill it in and
# chmod 600. It feeds docker compose, the API container and the deploy/backup
# scripts. Never commit the filled-in copy.

# --- docker compose ---
# Database password for the postgres container (required)
POSTGRES_PASSWORD=
# Host port the API is published on (127.0.0.1 only); must match the
# upstream in deploy/nginx/bugun.conf
API_PORT=8090
# The API container does not migrate on start; deploy.sh runs "migrate up".
MIGRATE_ON_START=false

# --- API (see backend/.env.example for the full list and meaning) ---
# DATABASE_URL, APP_ENV, HTTP_ADDR and MEDIA_DIR are set by docker-compose.yml.
WEB_URL=
API_URL=
COOKIE_DOMAIN=
CORS_ORIGINS=
INTERNAL_SECRET=
SESSION_TTL=720h
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
ADMIN_TELEGRAM_IDS=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_PER_HOUR=100
# Other models on the same API and key for the chat assistant, tried when
# the main one is rate limited (comma separated), e.g.
# openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_FALLBACK_MODELS=
# Proxies whose X-Forwarded-For / X-Real-IP the API trusts, comma-separated
# CIDRs. docker-compose.yml defaults it to 172.16.0.0/12 (nginx reaches the
# container through the Docker bridge gateway); override only if Docker uses
# other address pools.
TRUSTED_PROXIES=
# Photo size limit; nginx client_max_body_size (bugun.conf) must stay above it.
MEDIA_MAX_UPLOAD_BYTES=10485760
# Scheduler heartbeat, pinged by the API while its jobs run
# (e.g. a healthchecks.io check URL). Empty = off.
HEARTBEAT_URL=

# --- deploy/backup.sh ---
# Where dumps and media archives go (default: <DEPLOY_DIR>/../backups)
BACKUP_DIR=
# Days to keep local (and offsite) backups
BACKUP_RETENTION_DAYS=14
# Optional offsite copy with rclone, e.g. "b2:bugun-backups/prod"
# (configure the remote once with "rclone config" as the deploy user). Empty = off.
RCLONE_REMOTE=
# Days to keep offsite copies (default: BACKUP_RETENTION_DAYS; 0 = never delete)
RCLONE_RETENTION_DAYS=
# Pinged after every successful backup, "<url>/fail" on failure
# (healthchecks.io style). Empty = off.
BACKUP_HEARTBEAT_URL=

# --- deploy/deploy.sh ---
# Branch the server follows (fast-forward only)
DEPLOY_BRANCH=main
# Seconds to wait for /healthz after starting a new image
HEALTH_TIMEOUT=60
# How many SHA-tagged API images to keep for manual rollback
KEEP_IMAGES=5
