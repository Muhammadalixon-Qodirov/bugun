APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://localhost:5432/bugun?sslmode=disable

WEB_URL=http://localhost:3000
# Production: public API URL, shared cookie domain, extra CORS origins,
# and a secret shared with the site's server (INTERNAL_API_SECRET there).
API_URL=
COOKIE_DOMAIN=
CORS_ORIGINS=
INTERNAL_SECRET=

SESSION_TTL=720h
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Set to false where another copy of the bot is already polling
BOT_ENABLED=true

# From @BotFather: bot token, and Bot Settings -> Login (OpenID Connect)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Listing photos (outside the repository)
MEDIA_DIR=data/media
# Telegram user ids that may open /admin, comma separated
ADMIN_TELEGRAM_IDS=

# Optional: a language model reads channel posts the rules cannot (any
# OpenAI-compatible chat API, e.g. https://api.groq.com/openai/v1 or
# https://generativelanguage.googleapis.com/v1beta/openai). Off while empty.
# Posts are sent to that service; every price is still checked against the
# catalog and must be written in the post.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_PER_HOUR=100
# Other models on the same API and key for the chat assistant, tried when
# the main one is rate limited (comma separated).
LLM_FALLBACK_MODELS=

# Apply database migrations at start. Set to false where a separate step runs
# them first (go run ./cmd/migrate up, or the migrate binary).
MIGRATE_ON_START=true

# HTTP server. REQUEST_TIMEOUT cuts off a slow handler; HTTP_WRITE_TIMEOUT
# bounds a whole response (reports, CSV) and must be longer.
REQUEST_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
RATE_LIMIT_PER_MINUTE=120
# Proxies whose X-Forwarded-For / X-Real-IP are believed (CIDRs, comma
# separated). Everyone else is rate limited by their own address.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Messages and button presses one user may send the bot a minute
BOT_MESSAGES_PER_MINUTE=20

# Optional external uptime check, e.g. a healthchecks.io ping URL; empty = off
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=5m

# Scheduled jobs: a running job refreshes its lease every JOB_HEARTBEAT; an
# unfinished run is released only after JOB_LEASE_TIMEOUT without one.
JOB_HEARTBEAT=1m
JOB_LEASE_TIMEOUT=5m

# Schedules, Asia/Tashkent time: HH:MM, comma separated; weekly as "Mon 09:00"
SCHEDULE_AUTO_PRICING=07:30,12:00,16:30
SCHEDULE_ANOMALIES=03:30
SCHEDULE_SELLER_SCORES=04:00
SCHEDULE_SESSIONS_CLEANUP=04:30
SCHEDULE_FX=10:15
SCHEDULE_WEATHER=06:30
SCHEDULE_SELLER_DIGEST=19:00
SCHEDULE_WATCH_ALERTS=08:00,17:00
SCHEDULE_RATING_PROMPTS=11:00
SCHEDULE_WEEKLY_REMINDER=Mon 09:00

# Daily price anomalies: robust z-score, smallest move against the series'
# past and against the other viloyatlar, viloyatlar needed to compare
ANOMALY_Z=3.5
ANOMALY_MIN_MOVE=0.25
ANOMALY_MIN_CROSS_MOVE=0.3
ANOMALY_MIN_PROVINCES=5

# Automatic pricing: goal factors against the market median, the most a price
# may move in a day, the pause after a price set by hand, and the market views
# needed before contact rates are compared
REPRICE_GOAL_FAST=0.97
REPRICE_GOAL_BALANCED=1.00
REPRICE_GOAL_PROFIT=1.03
REPRICE_DAILY_STEP=0.05
AUTO_PRICE_MANUAL_PAUSE=24h
AUTO_PRICE_MIN_MARKET_VIEWS=100

# Buyer requests: open requests per buyer, answer deadline in days
RFQ_MAX_OPEN=3
RFQ_DEFAULT_DAYS=3
RFQ_MIN_DAYS=1
RFQ_MAX_DAYS=7

# Listing photos: upload size in bytes, width x height, photos per listing
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_PIXELS=40000000
MAX_PHOTOS_PER_LISTING=5

# Forecast: weeks ahead, trend damping per week and its cap, past weeks the
# methods must be tested on, share of past errors inside the interval
FORECAST_WEEKS=4
FORECAST_TREND_DAMPING=0.8
FORECAST_MAX_TREND_EFFECT=0.15
FORECAST_MIN_BACKTESTS=20
FORECAST_INTERVAL_QUANTILE=0.8

# Similar viloyat groups: share of viloyatlar a product needs, share of those
# products a viloyat needs, least viloyatlar and products to group, most
# groups tried, products named per group, smallest difference worth naming
CLUSTER_PROFILE_COVERAGE=0.7
CLUSTER_PROVINCE_COVERAGE=0.5
CLUSTER_MIN_PROVINCES=6
CLUSTER_MIN_PRODUCTS=5
CLUSTER_MAX_GROUPS=5
CLUSTER_TOP=3
CLUSTER_NOTABLE_GAP=0.03

# Interval jobs (must divide a day evenly): price history refresh, deal
# follow-up questions, platform monitoring
SCHEDULE_PRICE_DAILY_EVERY=1h
SCHEDULE_DEAL_PROMPTS_EVERY=15m
SCHEDULE_MONITORING_EVERY=1h

# Photo storage: disk (MEDIA_DIR) or s3 (any S3-compatible service: AWS,
# MinIO, R2, Spaces). Copy existing photos first: go run ./cmd/mediasync
# S3_ENDPOINT is host[:port] or http(s)://host[:port]; self-hosted services
# usually need S3_USE_PATH_STYLE=true. With S3_PUBLIC_BASE_URL (a public
# address of the bucket) photos of live listings are redirected there; all
# other photos still stream through the API's access checks.
MEDIA_STORAGE=disk
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Telegram Mini App sign-in: how old the Mini App's signed init data may be
TELEGRAM_WEBAPP_MAX_AGE=1h

# Optional error tracking (Sentry or a compatible service); off while
# SENTRY_DSN is empty. Cookies, auth headers, IPs and phone numbers are
# removed before sending. SENTRY_ENVIRONMENT defaults to APP_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Live UzEx exchange quotes (wheat, rebar, cement) as official benchmarks,
# fetched daily at SCHEDULE_UZEX (Tashkent time). Off by default.
UZEX_ENABLED=false
UZEX_URL=https://uzex.uz/Quote/GetQuotes
SCHEDULE_UZEX=18:30

# Optional model features (spec §9), all off until configured. Each speaks an
# OpenAI-compatible API; without it the rule-based path answers. Numbers are
# never taken from a model: they come from the app's own functions, and every
# price a model reads is checked against the catalog and the text.
# Timeout of one chat call (LLM_* above).
LLM_TIMEOUT=20s
# Cost column of ai_log: "model=in:out[:audio_minute]" in USD per 1M tokens
# and per audio minute, comma separated, e.g. gpt-4o-mini=0.15:0.6,whisper-1=0:0:0.006
AI_MODEL_PRICES=
# ai_log rows (every model call, no prompt text) are kept this many days.
AI_LOG_RETENTION_DAYS=90
SCHEDULE_AI_LOG_CLEANUP=04:45
# AI-5 analyst: the chat model answers /savol and POST /v1/ask through fixed
# functions; tool rounds per question and model answers per user or IP a minute.
ANALYST_ENABLED=false
ANALYST_MAX_TOOL_ROUNDS=4
ANALYST_PER_MINUTE=6
# AI-1 speech to text (bot voice messages, the site's voice button), e.g.
# https://api.groq.com/openai/v1 with whisper-large-v3. Audio is sent there.
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
STT_LANGUAGE=uz
STT_MAX_SECONDS=60
STT_MAX_PER_HOUR=200
# AI-3 prices from a photo: a vision-capable chat model; base URL and key
# default to LLM_*. Photos are re-encoded (no EXIF/GPS) before sending.
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
# AI-4 catalog matching: optional embeddings next to the dictionary and
# pg_trgm; base URL and key default to LLM_*. Below MATCH_MIN_CONFIDENCE the
# seller picks from candidates scoring at least MATCH_MIN_CANDIDATE.
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
MATCH_MIN_CONFIDENCE=0.6
MATCH_MIN_CANDIDATE=0.3
# AI-6: the chat model rewords the buy/sell advice (no new numbers allowed).
ADVICE_TEXT_ENABLED=false
# AI-7: the chat model also screens listing texts; a flag only holds a
# listing for review, a failure or timeout never blocks it.
MODERATION_ENABLED=false
MODERATION_TIMEOUT=4s
