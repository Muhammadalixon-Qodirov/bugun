# In development every address below may stay empty: the site then uses the
# local API (http://localhost:8080) through its /api proxy. A production build
# or server stops with an error when API_INTERNAL_URL or the site address is
# missing, instead of quietly calling localhost.

# Go API address used by the Next.js server (proxy and server components).
# Development default: http://localhost:8080
API_INTERNAL_URL=
# API address for the browser: "/api" to go through this site's proxy, or the
# API subdomain (e.g. https://bugun-api.e-investment.uz). Its origin is added to
# the Content-Security-Policy and to the allowed next/image sources.
# Default: /api
NEXT_PUBLIC_API_URL=
# Public address of this site (canonical links, sitemap, link previews), e.g.
# https://bugun.e-investment.uz. On Vercel it defaults to the production domain.
# Development default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Same value as INTERNAL_SECRET on the API server (server-side only, never NEXT_PUBLIC)
INTERNAL_API_SECRET=
# Bot username without @, shown on the profile page
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Public address of the photo storage the API's /media/{key} redirects to (the
# API's S3_PUBLIC_BASE_URL), e.g. https://media.example.com/bugun. Optional:
# leave empty while the API serves photos itself. Its host is added to the
# allowed next/image sources and the Content-Security-Policy img-src. Inlined
# at build time: rebuild after changing it.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Site the Playwright smoke tests (npm run test:e2e) open; default http://localhost:3100
E2E_BASE_URL=

# Error tracking (optional). Without NEXT_PUBLIC_SENTRY_DSN nothing is loaded or
# sent. With it, browser and server errors go to Sentry without cookies, IP
# addresses or phone numbers, and the Content-Security-Policy allows the DSN's
# host. The DSN is inlined at build time: rebuild after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Environment name shown in Sentry; default: the NODE_ENV (production/development)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Share of page loads traced for performance, 0–1; default 0 (errors only)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build only: upload source maps to Sentry (and keep them out of the public
# build). Without the token no source maps are uploaded and the build does not
# contact Sentry. Never NEXT_PUBLIC.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
